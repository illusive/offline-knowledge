{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "stead (dev)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev", "--", "--port", "5173", "--strictPort"],
      "port": 5173
    },
    {
      "name": "stead (offline build)",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd web && npm run build && npx vite preview --port 4173 --strictPort"],
      "port": 4173
    }
  ]
}
