{
  "expo": {
    "name": "Offline Knowledge",
    "slug": "offline-knowledge",
    "scheme": "offlineknowledge",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.example.offlineknowledge"
    },
    "plugins": [
      "expo-router",
      ["expo-sqlite", { "enableFTS": true }],
      "expo-localization"
    ]
  }
}
